<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Chest requests no network permission at all.

      An app that claims to protect your data should not be able to send it
      anywhere, and the strongest way to make that claim verifiable is to make
      it impossible. There is no INTERNET permission below, so no code path in
      Chest — including a compromised dependency — can exfiltrate a vault.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Re-applies hidden state after a reboot or an app update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Required to list installed apps so the user can choose what to hide.
      Also covers the WhatsApp deep link: on API 30+ an app cannot see another
      package unless it declares an interest, so without this entry the contact
      button would report WhatsApp as missing on a phone that has it.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/chest_data_extraction_rules"
        android:hasFragileUserData="false"
        android:networkSecurityConfig="@xml/chest_network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="false">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Device-admin receiver. Declared without BIND_DEVICE_ADMIN permission
          on purpose: the platform grants the admin binding only after the user
          approves it through the system dialog.
        -->
        <receiver
            android:name=".applock.ChestDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/chest_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          Re-applies the recorded hidden state after a reboot or an app update,
          so a failed write cannot leave an app hidden with no way to restore it.
        -->
        <receiver
            android:name=".applock.ChestBootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Enforcement service. Bound by the framework only after the user
          enables it in Accessibility settings. Needs no computer and no factory
          reset: this is the phone-only tier.
        -->
        <service
            android:name=".applock.ChestAppLockService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/chest_accessibility_service" />
        </service>

        <!--
          Dismisses notifications from frozen apps. A separate service because an
          accessibility service cannot cancel another app's notification; only a
          NotificationListenerService can. Granted on the device, in Settings,
          with no computer involved.
        -->
        <service
            android:name=".applock.ChestNotificationGuard"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Publishes a decrypted file to whatever app the user picks, so a sealed
          photo can be saved back to the gallery or sent on without Chest ever
          writing plaintext somewhere another app can stumble across. The paths
          file restricts it to Chest's own cache directory.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.chest.files"
            android:exported="false"
            android:grantUriPermissions="true"
            android:label="@string/file_provider_label">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/chest_file_paths" />
        </provider>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
      Package visibility. Chest needs to enumerate launchable apps so the user
      can pick what to freeze; it queries launcher activities and nothing else.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Lets Chest see whether WhatsApp is installed before offering it. -->
        <package android:name="com.whatsapp" />
    </queries>
</manifest>
