<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while the process starts, before Flutter draws a frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Theme applied once the process has started.

         Deliberately dark: Chest displays vault contents, so the recents
         thumbnail must not be a light, readable snapshot. FLAG_SECURE is also
         set at runtime in MainActivity. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
